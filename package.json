{
  "name": "portfolio-site-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test:unit": "vitest run tests/unit/",
    "test:build": "vitest run tests/build/",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build && pnpm test:build"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.8",
    "astro": "7.2.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "22.15.0",
    "cheerio": "^1.2.0",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.11"
  }
}
